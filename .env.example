# ─── FRIDAY / ARIA Backend — environment variable template ───────────────────
# Copy this file to `.env` for local development and fill in real values.
# On Railway, set these in the service's Variables tab instead — do NOT
# commit a real .env file (it is gitignored).

# ─── REQUIRED ─────────────────────────────────────────────────────────────────

# Google Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter API key — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Shared secret between the Android app and this backend.
# Requests without this exact token are rejected (401).
# Generate a strong random value, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_TOKEN=

# ─── OPTIONAL (sensible defaults) ─────────────────────────────────────────────

# Comma-separated CORS origins. "*" allows all (safe here because the API is
# token-protected and the client is a native Android app, not a browser).
# ALLOWED_ORIGINS=*

# Identify this app to OpenRouter (shows in their dashboard/rankings).
# APP_REFERER=https://github.com/cheregebe/FRIDAY-AI-Assistant
# APP_TITLE=FRIDAY AI Assistant

# Version reported by /version, /health and startup logs (default: 1.0.0).
# APP_VERSION=1.0.0

# ChromaDB storage path for the (not-yet-active) memory system.
# On Railway, point this at a mounted Volume, e.g. /data/friday_memory_db
# CHROMA_PATH=./aria_memory_db

# PORT is injected automatically by Railway — never set it there manually.
# Locally the server defaults to 8000.
# PORT=8000
